# Generated by scripts/build-formula.mjs from packaging/homebrew/conductor.rb.in. Do not edit the output.
class Conductor < Formula
  desc "@DESC@"
  homepage "@HOMEPAGE@"
  url "@URL@"
  sha256 "@SHA256@"

  depends_on :macos
  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink libexec.glob("bin/*")
  end

  # No `service` block on purpose: the daemon runs under the launchd label
  # ai.conductor.daemon, which `conductor install` writes and loads. A
  # `brew services` job would be a second daemon under a different label.
  def caveats
    <<~EOS
      Nothing is running yet. To start the daemon now and at every login:
        conductor install

      After every `brew upgrade` of conductor or node, run it again:
        conductor install
      The LaunchAgent records the versioned Cellar paths of both.

      Agents need Playwright's Chromium for browser work. `conductor doctor`
      reports whether it is present and prints the command that installs it.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/conductor --version")
    assert_match version.to_s, shell_output("#{bin}/conductord --version")
  end
end
