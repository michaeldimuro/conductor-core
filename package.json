{
  "name": "conductor",
  "version": "0.1.0",
  "description": "Local-first, always-on agent orchestration harness",
  "scripts": {
    "build": "tsc -p tsconfig.json --declaration && node scripts/copy-assets.mjs && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc -p config/tsconfig.check.json",
    "test": "vitest run --config config/vitest.config.ts",
    "lint": "eslint --config config/eslint.config.mjs src tests",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "dev": "tsx src/daemon/main.ts --serve",
    "dev:ui": "vite --config ui/vite.config.ts",
    "package:pkg": "node scripts/build-pkg.mjs",
    "package:formula": "node scripts/build-formula.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.1.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "openai": "^7.55.0",
    "pino": "^10.4.0",
    "playwright": "^1.65.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "lucide-react": "1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "conductor": "bin/conductor.mjs",
    "conductord": "bin/conductord.mjs"
  },
  "exports": {
    "./adapters/sdk": {
      "types": "./dist/adapters/sdk.d.ts",
      "default": "./dist/adapters/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist",
    "examples"
  ]
}
